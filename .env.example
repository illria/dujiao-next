# ProdSeller API key is read only from the deployment environment.
# Never put the real value in this file, the database, logs, or Git.
PRODSELLER_API_KEY=

# UPay credentials may be provided by the protected admin payment-channel
# configuration or by the deployment environment.
# Never put real values in this example file, logs, or Git.
UPAY_APP_ID=
UPAY_APP_SECRET=
